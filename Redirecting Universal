<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Redirecting...</title>
<script>
  (function() {
    // Your repo folder
    const repo = "ubg98.github.io";

    // Current page path
    let path = window.location.pathname;

    // If the path doesn’t already include your repo folder, add it
    if (!path.includes(repo)) {
      path = "/" + repo + path.replace(/^\/+/, "");
      window.location.replace(path);
    }

    // Optional: if file not found, redirect to home
    setTimeout(() => {
      window.location.replace("/" + repo + "/index.html");
    }, 3000); // 3 seconds fallback
  })();
</script>
</head>
<body>
  <p>Redirecting to the correct page...</p>
  <p>If nothing happens, <a href="../index.html">click here</a>.</p>
</body>
</html>
